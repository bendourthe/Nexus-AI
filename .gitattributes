# v1.1.0 Phase 1.8 -- normalize snapshot test fixtures to LF so the
# characterization tests in tests/unit/agents/SubAgentManager.characterization.test.ts
# pass on Windows checkouts (the default core.autocrlf=true would otherwise
# rewrite the *.txt snapshots to CRLF and break the byte-exact comparison).
#
# Scope this attribute as narrowly as possible: only the snapshot fixtures
# under tests/snapshots/specialists/ are byte-exact and must stay LF.
# Everything else is left to the user's default eol behaviour so editor /
# native-tooling expectations on each OS are preserved.

tests/snapshots/specialists/*.txt text eol=lf
tests/snapshots/specialists/*.json text eol=lf

# v2.11.0 Phase 2 -- the outline fixture documents are byte-exact inputs: the
# PDFs carry cross-reference byte offsets and bom-crlf.md exists to test CRLF.
# An autocrlf rewrite on a Windows checkout would corrupt both.
tests/fixtures/documents/outline/docs/* -text

# Frozen rewrite evaluation hashes require identical bytes on every host.
tests/fixtures/rewrite-eval/*.json text eol=lf
docs/archives/v2/v2.14/development/v2.14.1-rewrite-contract.json* text eol=lf
docs/archives/v2/v2.14/development/rewrite-eval/*.json* text eol=lf

# v2.15.0 -- the known-gaps fixtures are parsed once by the pinned checker and the
# captured results are committed, so their bytes must not change with the checkout.
tests/fixtures/known-gaps/** text eol=lf
